# ==============================================================================
# RESTYDEALS LANDING - CONFIGURAZIONE EMAIL CANDIDATURE
# Le candidature e i lead vengono inviati a: restydeals.managing@gmail.com
# ==============================================================================

# Destinatario dove ricevere le notifiche delle candidature
NOTIFICATION_EMAIL=restydeals.managing@gmail.com

# ------------------------------------------------------------------------------
# OPZIONE A: GMAIL CON "PASSWORD PER LE APP" (Consigliata, nessun servizio extra)
# ------------------------------------------------------------------------------
# Come configurarla in 1 minuto:
# 1. Accedi a https://myaccount.google.com con l'account restydeals.managing@gmail.com
# 2. Vai su "Sicurezza" -> Assicurati che "Verifica in due passaggi" sia ATTIVA.
# 3. Cerca "Password per le app" (oppure vai su https://myaccount.google.com/apppasswords)
# 4. Assegna un nome (es: "Landing RestyDeals") e clicca "Crea".
# 5. Google ti mostrerà un codice di 16 lettere (es: "abcd efgh ijkl mnop").
# 6. Incolla il codice qui sotto senza spazi o con gli spazi (viene pulito in automatico):
#
# GMAIL_USER=restydeals.managing@gmail.com
# GMAIL_APP_PASSWORD=tuo_codice_di_16_lettere

# ------------------------------------------------------------------------------
# OPZIONE B: RESEND (Servizio API moderno, gratis fino a 3.000 email/mese)
# ------------------------------------------------------------------------------
# 1. Registrati gratis su https://resend.com con la mail restydeals.managing@gmail.com
# 2. Vai su "API Keys" -> "Create API Key" e copiala.
# 3. Incolla la chiave qui sotto:
#
# RESEND_API_KEY=re_123456789
# EMAIL_FROM=RestyDeals <onboarding@resend.dev>
